# ---------------------------------------------------------------------------
# Read by react-native-dotenv and inlined into the bundle at build time.
# Every value here is readable by anyone with the build.
#
# Restart with a cleared cache after editing this file:
#   npm start -- --reset-cache
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Firebase (Project settings -> General -> Your apps -> Web app)
# Public by design — Firestore rules are what actually protect your data.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Use the "Web client" ID that Firebase auto-creates when you enable Google
# sign-in, NOT the iOS or Android client id.
GOOGLE_WEB_CLIENT_ID=

# ---------------------------------------------------------------------------
# Almanac (the in-app assistant)
# ---------------------------------------------------------------------------

# Your own endpoint, which holds the provider API key and forwards to the
# Messages API. This is the only mode you should ship. See
# server/proxy.example.js for a working reference implementation.
# Use your machine's LAN IP for device testing — localhost on a phone is the phone.
AI_PROXY_URL=

# Optional. Defaults to claude-sonnet-5. Verify current model ids at
# https://docs.claude.com/en/api/overview
AI_MODEL=

# Development shortcut ONLY. Embeds the key in the bundle, where anyone can
# extract it in about a minute. src/config/env.js hard-nulls this outside
# __DEV__ so it cannot reach a release build, but don't get in the habit.
#
# On Android, a plain-HTTP proxy also needs usesCleartextTraffic in the debug
# manifest — see NATIVE_SETUP.md.
AI_DEV_API_KEY=
