# ---------------------------------------------------------------------------
# Read by react-native-dotenv and inlined into the bundle at build time.
# Every value here is readable by anyone with the build.
#
# Restart with a cleared cache after editing this file:
#   npm start -- --reset-cache
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Firebase (Project settings -> General -> Your apps -> Web app)
# Public by design — Firestore rules are what actually protect your data.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Use the "Web client" ID that Firebase auto-creates when you enable Google
# sign-in, NOT the iOS or Android client id.
GOOGLE_WEB_CLIENT_ID=

# ---------------------------------------------------------------------------
# Almanac (the in-app assistant)
# ---------------------------------------------------------------------------

# Almanac uses the Google Gemini API. Leave all three empty and the app still
# works; the assistant just shows "Not connected".
#
# Your own endpoint, which holds the Gemini API key and forwards requests.
# This is the only mode you should ship. See server/proxy.example.js.
# Debug builds: http://<your LAN IP>:8787/almanac (localhost on a phone is the phone).
# Release APK: must be https:// (release builds block plain http).
AI_PROXY_URL=

# Optional, development (direct) mode only: a proxy picks its own model via
# GEMINI_MODEL. Defaults to gemini-3.5-flash-lite. Current model ids:
# https://ai.google.dev/gemini-api/docs/models
AI_MODEL=

# Development shortcut ONLY: a Gemini key from https://aistudio.google.com/apikey.
# It is embedded in the bundle, where anyone can extract it. src/config/env.js
# hard-nulls it outside __DEV__ so it cannot reach a release build. Never commit
# your real .env (it is in .gitignore).
#
# On Android, a plain-HTTP proxy also needs usesCleartextTraffic in the debug
# manifest — see NATIVE_SETUP.md.
AI_DEV_API_KEY=
